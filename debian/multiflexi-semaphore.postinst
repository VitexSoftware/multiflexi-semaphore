#!/bin/sh
# postinst script for multiflexi-semaphore
set -e

case "$1" in
    configure)
        if [ -x /usr/bin/multiflexi-cli ]; then
            multiflexi-cli credential-prototype:sync

            for file in /usr/lib/multiflexi-semaphore/multiflexi/*.json; do
                [ -f "$file" ] && multiflexi-cli application:import-json --file "$file" || true
            done
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
